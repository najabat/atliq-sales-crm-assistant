# Copy this file to .env.local and fill in the values. Type them yourself.
# Never paste a key into a chat, a prompt, a commit or a screenshot.
# .env.local is ignored by Git, so it never uploads.

# Needed. Any phrase of 12 or more characters. The only value that also goes into Vercel.
APP_PASSCODE=

# Needed. Prepaid, about 5 USD, auto reload off, 5 USD spend limit. Claude Haiku 5.5 runs on this laptop only.
# Never add this one to Vercel.
ANTHROPIC_API_KEY=
